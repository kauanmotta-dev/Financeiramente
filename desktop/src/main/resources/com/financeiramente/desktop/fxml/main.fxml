<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.financeiramente.desktop.ui.MainController">

    <top>
        <MenuBar>
            <Menu text="Configurações">
                <MenuItem text="Categorias" onAction="#abrirCategorias" />
            </Menu>
        </MenuBar>
    </top>

    <center>
        <StackPane fx:id="contentPane">
            <Label text="Dashboard — em construção"
                   style="-fx-font-size: 24; -fx-text-fill: #555;" />
        </StackPane>
    </center>

    <bottom>
        <Label fx:id="statusLabel"
               style="-fx-padding: 4 8; -fx-background-color: #f0f0f0; -fx-font-size: 12;" />
    </bottom>

</BorderPane>

