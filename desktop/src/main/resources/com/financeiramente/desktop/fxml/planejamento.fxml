<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.financeiramente.desktop.ui.PlanejamentoController"
      spacing="12.0"
      style="-fx-padding: 16;"
      prefHeight="680.0"
      prefWidth="700.0">

    <!-- Cabeçalho -->
    <HBox spacing="12.0" style="-fx-alignment: center-left;">
        <Label fx:id="lblTitulo"
               text="Planejamento Mensal"
               style="-fx-font-size: 20; -fx-font-weight: bold;" />
        <Label fx:id="lblBadgeConfirmado"
               text="✓ Confirmado"
               style="-fx-background-color: #4CAF50; -fx-text-fill: white;
                      -fx-padding: 4 10; -fx-background-radius: 4;"
               visible="false"
               managed="false" />
    </HBox>

    <!-- Receita esperada -->
    <HBox spacing="12.0" style="-fx-alignment: center-left;">
        <Label text="Receita Esperada (R$):" minWidth="200.0" />
        <TextField fx:id="tfReceitaEsperada" promptText="0.00" prefWidth="150.0" />
    </HBox>

    <!-- Reserva para imprevistos -->
    <HBox spacing="12.0" style="-fx-alignment: center-left;">
        <Label text="Reserva para Imprevistos (R$):" minWidth="200.0" />
        <TextField fx:id="tfReservaImprevisto" promptText="0.00" prefWidth="150.0" />
    </HBox>

    <!-- Barra de ações -->
    <HBox spacing="8.0">
        <Button fx:id="btnSalvarCabecalho"
                text="Salvar Receita e Reserva"
                onAction="#onSalvarCabecalho"
                style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
        <Button fx:id="btnConfirmar"
                text="Confirmar Plano"
                onAction="#onConfirmarPlano"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
        <Button fx:id="btnDefinirPadrao"
                text="Definir como Padrão"
                onAction="#onDefinirPadrao" />
    </HBox>

    <!-- Separador -->
    <Label text="Limites por Categoria"
           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 8 0 4 0;" />

    <!-- Barra de progresso gasto vs planejado -->
    <HBox spacing="8.0" style="-fx-alignment: center-left;">
        <Label text="Gasto vs. Planejado:" />
        <ProgressBar fx:id="pbGlobal" prefWidth="300.0" progress="0.0" />
        <Label fx:id="lblProgressoTexto" text="0 / 0" />
    </HBox>

    <!-- Tabela de categorias com campos de limite -->
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true">
        <ListView fx:id="lvCategorias" />
    </ScrollPane>

    <!-- Status -->
    <Label fx:id="lblStatus"
           style="-fx-font-size: 12; -fx-text-fill: #555;" />

</VBox>
