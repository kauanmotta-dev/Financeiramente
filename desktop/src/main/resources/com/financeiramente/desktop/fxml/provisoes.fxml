<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.financeiramente.desktop.ui.ProvisoesController">

    <top>
        <VBox style="-fx-padding: 12; -fx-spacing: 8; -fx-background-color: #fafafa;">
            <Label text="Provisões"
                   style="-fx-font-size: 18; -fx-font-weight: bold;" />
        </VBox>
    </top>

    <center>
        <HBox spacing="12" style="-fx-padding: 12;">

            <!-- Lista -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="420">
                <Label text="Provisões Ativas" style="-fx-font-weight: bold;" />
                <ListView fx:id="lvProvisoes" VBox.vgrow="ALWAYS" prefHeight="500" />
                <HBox spacing="8">
                    <Button text="Nova" onAction="#novaProvisao"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
                    <Button fx:id="btnEditar" text="Editar" onAction="#editarSelecionado"
                            disable="true" />
                    <Button fx:id="btnDesativar" text="Desativar" onAction="#desativarSelecionado"
                            style="-fx-background-color: #F44336; -fx-text-fill: white;"
                            disable="true" />
                </HBox>
            </VBox>

            <Separator orientation="VERTICAL" />

            <!-- Formulário -->
            <VBox fx:id="vboxForm" spacing="10" prefWidth="320">
                <Label fx:id="lblTituloForm" text="Nova Provisão"
                       style="-fx-font-weight: bold; -fx-font-size: 14;" />

                <Label text="Nome" />
                <TextField fx:id="tfNome" promptText="Ex: Troca de pneu" />

                <Label text="Total Anual (R$)" />
                <TextField fx:id="tfTotalAnual" promptText="Ex: 660.00" />

                <Label text="Valor Mensal (R$)" />
                <TextField fx:id="tfValorMensal" promptText="Ex: 55.00" />

                <Label text="Categoria (opcional)" />
                <Spinner fx:id="spCategoria" editable="false" prefWidth="300" />

                <Label fx:id="lblErro" style="-fx-text-fill: red;" visible="false" />

                <HBox spacing="8">
                    <Button text="Salvar" onAction="#salvar"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                    <Button text="Cancelar" onAction="#cancelar" />
                </HBox>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <Label fx:id="lblStatus"
               style="-fx-padding: 4 8; -fx-background-color: #f0f0f0; -fx-font-size: 12;" />
    </bottom>

</BorderPane>
