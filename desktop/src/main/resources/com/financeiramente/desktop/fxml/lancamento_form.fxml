<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.financeiramente.desktop.ui.LancamentoFormController"
      spacing="12"
      style="-fx-padding: 20;">

    <Label fx:id="lblTitulo" text="Novo Lançamento" styleClass="page-title" />

    <!-- Tipo -->
    <HBox spacing="20" alignment="CENTER_LEFT">
        <Label text="Tipo:" />
        <RadioButton fx:id="rbDespesa" text="Despesa" selected="true">
            <toggleGroup><ToggleGroup fx:id="tgTipo" /></toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbReceita" text="Receita" toggleGroup="$tgTipo" />
    </HBox>

    <!-- Grid de campos -->
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Valor (R$):" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <TextField fx:id="tfValor" promptText="0,00"
                   GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Descrição:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <TextField fx:id="tfDescricao" promptText="Descrição obrigatória"
                   GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Categoria:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <ComboBox fx:id="cbCategoria" maxWidth="Infinity"
                  GridPane.rowIndex="2" GridPane.columnIndex="1" />

        <Label text="Data:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
        <DatePicker fx:id="dpData"
                    GridPane.rowIndex="3" GridPane.columnIndex="1" />

    </GridPane>

    <!-- Label de erro -->
    <Label fx:id="lblErro" text="" style="-fx-text-fill: red;" />

    <!-- Botões -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar" styleClass="btn-ghost" />
        <Button fx:id="btnSalvar" text="Salvar" onAction="#salvar"
                defaultButton="true" styleClass="btn-primary" />
    </HBox>

</VBox>
