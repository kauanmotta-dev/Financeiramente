<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.financeiramente.desktop.ui.MetasController">

    <top>
        <VBox style="-fx-padding: 12; -fx-spacing: 8; -fx-background-color: #fafafa;">
            <Label text="Metas Financeiras"
                   style="-fx-font-size: 18; -fx-font-weight: bold;" />
        </VBox>
    </top>

    <center>
        <HBox spacing="12" style="-fx-padding: 12;">

            <!-- Lista de metas -->
            <VBox spacing="8" HBox.hgrow="SOMETIMES" prefWidth="380">
                <Label text="Metas Ativas" style="-fx-font-weight: bold;" />
                <ListView fx:id="lvMetas" VBox.vgrow="ALWAYS" prefHeight="420" />
                <HBox spacing="8">
                    <Button text="Nova" onAction="#novaMeta"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white;" />
                    <Button fx:id="btnEditar" text="Editar" onAction="#editarSelecionado" disable="true" />
                    <Button fx:id="btnDesativar" text="Desativar" onAction="#desativarSelecionado"
                            style="-fx-background-color: #F44336; -fx-text-fill: white;" disable="true" />
                </HBox>
            </VBox>

            <Separator orientation="VERTICAL" />

            <!-- Formulário meta + detalhe/aportes -->
            <VBox spacing="10" HBox.hgrow="ALWAYS" prefWidth="500">

                <!-- Formulário da meta -->
                <Label fx:id="lblTituloForm" text="Nova Meta"
                       style="-fx-font-weight: bold; -fx-font-size: 14;" />

                <Label text="Nome" />
                <TextField fx:id="tfNome" promptText="Ex: Viagem para Europa" />

                <Label text="Valor Objetivo (R$)" />
                <TextField fx:id="tfValorObjetivo" promptText="Ex: 5000.00" />

                <Label text="Data Alvo (opcional, AAAA-MM-DD)" />
                <TextField fx:id="tfDataAlvo" promptText="Ex: 2025-12-31" />

                <Label text="Descrição (opcional)" />
                <TextField fx:id="tfDescricao" promptText="Descrição da meta" />

                <Label fx:id="lblErroMeta" style="-fx-text-fill: red;" visible="false" />

                <HBox spacing="8">
                    <Button text="Salvar" onAction="#salvarMeta"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                    <Button text="Cancelar" onAction="#cancelarMeta" />
                </HBox>

                <Separator />

                <!-- Detalhe da meta selecionada -->
                <Label fx:id="lblDetalheNome" text="Selecione uma meta"
                       style="-fx-font-weight: bold; -fx-font-size: 13;" />
                <ProgressBar fx:id="pbProgresso" progress="0" prefWidth="460" />
                <HBox spacing="16">
                    <Label fx:id="lblPercentual" text="0%" />
                    <Label fx:id="lblValores" text="R$ 0,00 / R$ 0,00" />
                </HBox>
                <Label fx:id="lblProjecao" text="" style="-fx-font-style: italic;" />

                <Label text="Histórico de Aportes" style="-fx-font-weight: bold;" />
                <ListView fx:id="lvAportes" prefHeight="140" />

                <Label text="Novo Aporte" style="-fx-font-weight: bold;" />
                <HBox spacing="8">
                    <TextField fx:id="tfAporteValor" promptText="Valor (R$)" prefWidth="120" />
                    <TextField fx:id="tfAporteData" promptText="AAAA-MM-DD" prefWidth="120" />
                    <TextField fx:id="tfAporteDescricao" promptText="Descrição (opcional)" HBox.hgrow="ALWAYS" />
                </HBox>
                <Label fx:id="lblErroAporte" style="-fx-text-fill: red;" visible="false" />
                <HBox spacing="8">
                    <Button text="Registrar Aporte" onAction="#salvarAporte"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
                    <Button text="Excluir Aporte Selecionado" onAction="#deletarAporteSelecionado"
                            style="-fx-background-color: #F44336; -fx-text-fill: white;" />
                </HBox>

            </VBox>

        </HBox>
    </center>

    <bottom>
        <Label fx:id="lblStatus"
               style="-fx-padding: 4 8; -fx-background-color: #f0f0f0; -fx-font-size: 12;" />
    </bottom>

</BorderPane>
