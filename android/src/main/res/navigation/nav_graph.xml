<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard">

    <!-- ── Top-level destinations (bottom nav) ── -->

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.financeiramente.android.ui.dashboard.DashboardFragment"
        android:label="@string/nav_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_lancamentoFormFragment"
            app:destination="@id/lancamentoFormFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_lancamentosListFragment"
            app:destination="@id/lancamentosListFragment" />
    </fragment>

    <fragment
        android:id="@+id/nav_metas"
        android:name="com.financeiramente.android.ui.metas.MetasFragment"
        android:label="@string/nav_metas">
        <action
            android:id="@+id/action_metasFragment_to_metaDetalheFragment"
            app:destination="@id/metaDetalheFragment" />
    </fragment>

    <fragment
        android:id="@+id/metaDetalheFragment"
        android:name="com.financeiramente.android.ui.metas.MetaDetalheFragment"
        android:label="@string/meta_detalhe">
        <argument
            android:name="metaId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/nav_relatorios"
        android:name="com.financeiramente.android.ui.relatorios.RelatoriosFragment"
        android:label="@string/nav_relatorios" />

    <fragment
        android:id="@+id/nav_configuracoes"
        android:name="com.financeiramente.android.ui.configuracoes.ConfiguracoesFragment"
        android:label="@string/nav_configuracoes">
        <action
            android:id="@+id/action_configuracoesFragment_to_categoriasFragment"
            app:destination="@id/categoriasFragment" />
        <action
            android:id="@+id/action_configuracoesFragment_to_recorrentesFragment"
            app:destination="@id/recorrentesFragment" />
    </fragment>

    <!-- ── Lançamentos ── -->

    <fragment
        android:id="@+id/lancamentosListFragment"
        android:name="com.financeiramente.android.ui.lancamentos.LancamentosListFragment"
        android:label="@string/nav_lancamentos">
        <action
            android:id="@+id/action_lancamentosListFragment_to_lancamentoFormFragment"
            app:destination="@id/lancamentoFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/lancamentoFormFragment"
        android:name="com.financeiramente.android.ui.lancamentos.LancamentoFormFragment"
        android:label="@string/form_lancamento">
        <argument
            android:name="lancamentoId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- ── Categorias ── -->

    <fragment
        android:id="@+id/categoriasFragment"
        android:name="com.financeiramente.android.ui.categorias.CategoriasFragment"
        android:label="@string/nav_categorias">
        <action
            android:id="@+id/action_categoriasFragment_to_categoriaFormFragment"
            app:destination="@id/categoriaFormFragment" />
    </fragment>


    <!-- ── Lançamentos Recorrentes (EP-08) ── -->

    <fragment
        android:id="@+id/recorrentesFragment"
        android:name="com.financeiramente.android.ui.recorrentes.RecorrentesFragment"
        android:label="@string/nav_recorrentes">
        <action
            android:id="@+id/action_recorrentesFragment_to_recorrenteFormFragment"
            app:destination="@id/recorrenteFormFragment" />
    </fragment>

    <fragment
        android:id="@+id/recorrenteFormFragment"
        android:name="com.financeiramente.android.ui.recorrentes.RecorrenteFormFragment"
        android:label="@string/form_recorrente">
        <argument
            android:name="recorrenteId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/categoriaFormFragment"
        android:name="com.financeiramente.android.ui.categorias.CategoriaFormFragment"
        android:label="@string/form_categoria">
        <argument
            android:name="categoriaId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="paiId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

</navigation>
