<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título mês/ano -->
            <TextView
                android:id="@+id/tv_titulo_planejamento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <!-- Badge "Confirmado" -->
            <TextView
                android:id="@+id/tv_badge_confirmado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/planejamento_confirmado"
                android:textColor="@android:color/white"
                android:background="#4CAF50"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp" />

            <!-- Receita esperada -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_receita_esperada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/planejamento_receita_esperada"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_receita_esperada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Reserva para imprevistos -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_reserva_imprevisto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/planejamento_reserva_imprevisto"
                android:layout_marginBottom="20dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_reserva_imprevisto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Seção: Limites por categoria -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/planejamento_limites_por_categoria"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />

            <ListView
                android:id="@+id/lv_categorias_plano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@android:color/transparent"
                android:dividerHeight="4dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Botões sticky no rodapé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_salvar_cabecalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planejamento_salvar_valores"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirmar_plano"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planejamento_confirmar"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_definir_padrao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/planejamento_definir_padrao"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

</LinearLayout>
