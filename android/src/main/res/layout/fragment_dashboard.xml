<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_titulo"
            android:textAppearance="@style/TextAppearance.Financeiramente.Title"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOnSurfaceVariant"
            app:cardBackgroundColor="?attr/colorSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_mes_atual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Financeiramente.Caption" />

                    <ImageButton
                        android:id="@+id/btn_toggle_saldo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_view"
                        android:tint="?attr/colorOnSurfaceVariant"
                        android:contentDescription="Mostrar/ocultar saldo" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_saldo_real"
                    android:textAppearance="@style/TextAppearance.Financeiramente.Caption"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tv_saldo_real"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ --"
                    android:textAppearance="@style/TextAppearance.Financeiramente.Display"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_saldo_disponivel"
                    android:textAppearance="@style/TextAppearance.Financeiramente.Caption"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tv_saldo_disponivel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R$ --"
                    android:textAppearance="@style/TextAppearance.Financeiramente.Amount"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="2dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pb_global"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:trackCornerRadius="4dp"
                    app:trackColor="?attr/colorOnSurfaceVariant"
                    app:indicatorColor="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tv_gasto_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dashboard_gasto"
                        android:textAppearance="@style/TextAppearance.Financeiramente.Caption"
                        android:textColor="@color/vermelho_error" />

                    <TextView
                        android:id="@+id/tv_receita_total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="@string/dashboard_receita"
                        android:textAppearance="@style/TextAppearance.Financeiramente.Caption"
                        android:textColor="@color/verde_success" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_aviso_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="0dp"
            app:cardCornerRadius="6dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view_aviso_essenciais_status"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_aviso_status_dot" />

                    <TextView
                        android:id="@+id/tv_aviso_essenciais"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAppearance="@style/TextAppearance.Financeiramente.Caption" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view_aviso_metas_status"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_aviso_status_dot" />

                    <TextView
                        android:id="@+id/tv_aviso_metas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAppearance="@style/TextAppearance.Financeiramente.Caption" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_registrar_lancamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dashboard_registrar_lancamento"
            app:icon="@android:drawable/ic_input_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_abrir_configuracoes"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_abrir_configuracoes"
            app:icon="@android:drawable/ic_menu_manage" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
